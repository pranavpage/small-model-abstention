{
  "experiment": "abstention-qwen3-1.7b",

  "paths": {
    "root": "/workspace/abstention",
    "data_dir": "data",
    "results_dir": "results",
    "checkpoints_dir": "checkpoints",
    "hf_home": "/workspace/hf"
  },

  "models": {
    "main": "Qwen/Qwen3-1.7B",
    "debug": "Qwen/Qwen3-0.6B",
    "ceiling": "Qwen/Qwen3-8B"
  },

  "prompt": {
    "system": "You answer questions using only the paragraph you are given. If the paragraph contains the answer, reply with the answer copied from the paragraph in 10 words or fewer. Do not write a full sentence and do not add anything else. If the paragraph does not contain the answer, reply exactly: I don't know",
    "user_template": "Paragraph:\n{context}\n\nQuestion: {question}",
    "enable_thinking": false
  },

  "data": {
    "dataset": "rajpurkar/squad_v2",
    "seed": 1234,
    "train_splits": { "sft": 3000, "dpo": 2000, "grpo": 1500, "dev": 300 },
    "test_size": 500
  },

  "eval": {
    "temperature": 0.0,
    "max_new_tokens": 64,
    "bootstrap_samples": 10000,
    "handcheck_samples": 50,
    "seed": 1234
  },

  "vllm": {
    "dtype": "bfloat16",
    "max_model_len": 4096,
    "gpu_memory_utilization": 0.85,
    "max_lora_rank": 16
  },

  "lora": {
    "r": 16,
    "alpha": 32,
    "dropout": 0.05,
    "target_modules": "all-linear"
  },

  "sft": {
    "epochs": 2,
    "learning_rate": 0.0002,
    "lr_scheduler": "linear",
    "warmup_ratio": 0.03,
    "per_device_batch_size": 8,
    "grad_accum_steps": 2,
    "max_length": 1024,
    "loss_on_answer_only": true,
    "max_answer_words": 10,
    "seed": 1234
  },

  "dpo": {
    "samples_per_question": 4,
    "sample_temperature": 1.0,
    "samples_run": "dpo-samples",
    "max_answer_words": 10,
    "beta": 0.1,
    "epochs": 2,
    "lr_scheduler": "linear",
    "warmup_ratio": 0.1,
    "per_device_batch_size": 4,
    "grad_accum_steps": 4,
    "max_length": 1024,
    "idk_probe_every": 5,
    "seed": 1234,
    "variants": {
      "dpo":    { "pair_mode": "class_balanced", "learning_rates": [0.000005, 0.00005] },
      "dpo-v2": { "pair_mode": "idk_balanced",   "learning_rates": [0.000005, 0.00002] }
    }
  },

  "grpo": {
    "samples_run": "grpo-samples",
    "pool": {
      "filter_run": "G-default",
      "drop_answerable_without_correct": true,
      "topup_samples_run": "dpo-samples",
      "topup_classes": ["unanswerable"],
      "seed": 1234
    },
    "num_generations": 8,
    "temperature": 1.0,
    "max_completion_length": 64,
    "questions_per_step": 4,
    "per_device_batch_size": 8,
    "passes": 2,
    "kl_beta": 0.04,
    "loss_type": "dapo",
    "learning_rate": 0.000001,
    "lr_scheduler": "constant",
    "eval_every_steps": 50,
    "seed": 1234,
    "gate": { "reference_dev_run": "sft-dev-e2", "max_p": 0.1, "min_gain": 0.02 },
    "flags": { "kl_mean_above": 0.5, "length_rising_evals": 3 },
    "runs": {
      "G-low":     { "h": 0.3, "r": 0.5 },
      "G-default": { "h": 1.0, "r": 0.5 },
      "G-high":    { "h": 3.0, "r": 0.5 },
      "G-hack":    { "h": 3.0, "r": 0.0 },
      "G-equal":   { "h": 1.0, "r": 1.0, "learning_rate": 0.00001 }
    }
  }
}
